name: build

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
  workflow_dispatch:

jobs:
  test:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: Run tests
        run: python tests/test_core.py

  package:
    needs: test
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-dev.txt
      - name: Build exe
        run: |
          python -m PyInstaller --noconfirm --clean --onefile --windowed `
            --name ScreenAnswer --icon "assets\icon.ico" `
            --hidden-import winrt --hidden-import winrt.windows.foundation `
            --hidden-import winrt.windows.foundation.collections `
            --hidden-import winrt.windows.globalization `
            --hidden-import winrt.windows.graphics.imaging `
            --hidden-import winrt.windows.media.ocr `
            --hidden-import winrt.windows.storage `
            --hidden-import winrt.windows.storage.streams `
            --hidden-import pypdf --collect-all pypdfium2 app.py
      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: ScreenAnswer-windows-x64
          path: dist/ScreenAnswer.exe
      - name: Attach to release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/ScreenAnswer.exe
